---
import ThemeToggle from '@components/react/ThemeToggle';
---

<nav class="w-full flex relative justify-between items-center mx-auto px-4 md:px-40 h-20 sticky top-0 z-50 backdrop-blur-sm bg-white/80 dark:bg-gray-900/80 border-b border-gray-200 dark:border-gray-800 transition-colors duration-300">
  <div class="inline-flex">
    <a href="/" class="flex items-center">
      <div class="text-xl font-bold text-gray-900 dark:text-white transition-colors">
        JSTorres.dev
      </div>
    </a>
  </div>
  
  <div class="flex items-center gap-6">
    <div class="flex items-center gap-4">
      <a href="#projects" class="inline-block py-2 px-3 text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-300 font-medium">
        Proyectos
      </a>
      <a href="#skills" class="inline-block py-2 px-3 text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-300 font-medium">
        Habilidades
      </a>
      <a href="#contact" class="inline-block py-2 px-3 text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-300 font-medium">
        Contacto
      </a>
    </div>
    
    <div class="w-px h-6 bg-gray-300 dark:bg-gray-700"></div>
    
    <!-- Componente simple sin contexto -->
    <ThemeToggle client:load />
  </div>
</nav>