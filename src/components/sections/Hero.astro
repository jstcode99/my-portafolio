---
// src/components/astro/Hero.astro
---

<section id="hero" class="w-full border-b border-gray-200 dark:border-gray-800 bg-gradient-to-br from-slate-50 to-blue-50 dark:from-slate-900 dark:to-blue-900/10 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 md:px-10 py-20">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="flex-col space-y-8">
        <div>
          <p class="text-sm font-mono text-blue-600 dark:text-blue-400 mb-4 transition-colors">
            [ Desarrollador de Software | Arquitectura & Full-Stack ]
          </p>
          <h1 class="text-5xl md:text-6xl font-bold text-gray-900 dark:text-white leading-tight transition-colors">
            Juan Sebastián
            <span class="block text-blue-600 dark:text-blue-400 transition-colors">Torres</span>
          </h1>
          <p class="text-2xl md:text-3xl text-gray-600 dark:text-gray-300 mt-4 mb-6 transition-colors">
            <strong>Desarrollador de Software</strong> especializado en aplicaciones web escalables
          </p>
        </div>

        <p class="text-xl text-gray-700 dark:text-gray-300 leading-relaxed transition-colors">
          Diseño y desarrollo <strong class="text-blue-600 dark:text-blue-400 transition-colors">software de calidad</strong> 
          que resuelve problemas empresariales complejos.
        </p>

        <div class="flex flex-wrap gap-4">
          <a href="#contact" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
            📧 Contratar Desarrollador
          </a>
          <a href="#projects" class="border-2 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-bold py-4 px-8 rounded-xl transition-all duration-300 hover:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
            📄 Ver Proyectos Software
          </a>
        </div>

        <div class="flex gap-8 pt-6">
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900 dark:text-white transition-colors">5+</div>
            <div class="text-sm text-gray-600 dark:text-gray-400 transition-colors">Años Desarrollo Software</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900 dark:text-white transition-colors">30%</div>
            <div class="text-sm text-gray-600 dark:text-gray-400 transition-colors">Eficiencia en Proyectos</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900 dark:text-white transition-colors">20+</div>
            <div class="text-sm text-gray-600 dark:text-gray-400 transition-colors">Proyectos Software</div>
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="bg-white dark:bg-gray-800 rounded-3xl p-8 shadow-2xl border border-gray-200 dark:border-gray-700 transition-colors duration-300">
          <img 
            src="/images/hero-desarrollo-software.jpg" 
            alt="Juan Sebastián Torres - Desarrollador de Software trabajando en código"
            width={600}
            height={400}
            class="w-full h-auto rounded-2xl"
            loading="eager"
          />
          <div class="absolute -bottom-4 -right-4 bg-blue-600 text-white px-4 py-2 rounded-xl shadow-lg transition-colors">
            💻 +5 años desarrollando software
          </div>
        </div>
      </div>
    </div>
  </div>
</section>