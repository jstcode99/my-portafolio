<section id="contact" class="w-full border-subtle-stroke border-x bg-gradient-to-br from-slate-50 to-blue-50 dark:from-slate-900 dark:to-blue-900/10">
    <div class="max-w-7xl mx-auto px-4 md:px-10 py-24">
        <!-- Header Section -->
        <div class="text-center mb-16">
            <span class="text-blue-600 dark:text-blue-400 font-mono text-sm mb-4 block">¿Listo para comenzar?</span>
            <h2 class="text-5xl md:text-6xl font-bold dark:text-white mb-6">
                Hablemos de tu
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600">proyecto</span>
            </h2>
            <p class="text-xl dark:text-gray-300 max-w-2xl mx-auto">
                Transformemos tus ideas en soluciones digitales impactantes. 
                Estoy aquí para ayudarte a hacerlo realidad.
            </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-16 items-start">
            <!-- Contact Information -->
            <div class="space-y-8">
                <!-- Contact Cards -->
                <div class="grid gap-6">
                    <!-- Email Card -->
                    <div class="group p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-500 transition-all duration-300 hover:shadow-xl">
                        <div class="flex items-start gap-4">
                            <div class="w-14 h-14 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <svg class="w-7 h-7 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <div class="flex-1">
                                <h3 class="text-lg font-semibold dark:text-white mb-2">Envíame un Email</h3>
                                <p class="text-blue-600 dark:text-blue-400 text-lg font-medium mb-1">tuemail@dev.com</p>
                                <p class="text-slate-600 dark:text-slate-400 text-sm">Respuesta en menos de 24 horas</p>
                            </div>
                        </div>
                    </div>

                    <!-- WhatsApp Card -->
                    <div class="group p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-green-300 dark:hover:border-green-500 transition-all duration-300 hover:shadow-xl">
                        <div class="flex items-start gap-4">
                            <div class="w-14 h-14 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <svg class="w-7 h-7 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                                </svg>
                            </div>
                            <div class="flex-1">
                                <h3 class="text-lg font-semibold dark:text-white mb-2">Chat por WhatsApp</h3>
                                <p class="text-green-600 dark:text-green-400 text-lg font-medium mb-1">+57 300 123 4567</p>
                                <p class="text-slate-600 dark:text-slate-400 text-sm">Respuesta inmediata</p>
                            </div>
                        </div>
                    </div>

                    <!-- LinkedIn Card -->
                    <div class="group p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-blue-400 dark:hover:border-blue-400 transition-all duration-300 hover:shadow-xl">
                        <div class="flex items-start gap-4">
                            <div class="w-14 h-14 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <svg class="w-7 h-7 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                                </svg>
                            </div>
                            <div class="flex-1">
                                <h3 class="text-lg font-semibold dark:text-white mb-2">Conectemos en LinkedIn</h3>
                                <p class="text-blue-600 dark:text-blue-400 text-lg font-medium mb-1">/in/tuperfil</p>
                                <p class="text-slate-600 dark:text-slate-400 text-sm">Para oportunidades profesionales</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Availability Banner -->
                <div class="p-6 bg-gradient-to-r from-blue-600 to-purple-600 rounded-2xl text-white">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
                            <span>🚀</span>
                        </div>
                        <h4 class="text-lg font-semibold">Disponible para Nuevos Proyectos</h4>
                    </div>
                    <p class="text-blue-100 text-sm">
                        Actualmente aceptando colaboraciones y proyectos desafiantes. 
                        ¡Hagamos realidad tu visión juntos!
                    </p>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="relative">
                <div class="bg-white dark:bg-slate-800 rounded-3xl p-8 md:p-10 border border-slate-200 dark:border-slate-700 shadow-2xl">
                    <div class="text-center mb-8">
                        <h3 class="text-3xl font-bold dark:text-white mb-3">Envíame un Mensaje</h3>
                        <p class="text-slate-600 dark:text-slate-400">Completa el formulario y me pondré en contacto contigo</p>
                    </div>
                    
                    <form class="space-y-6" action="/api/contact" method="POST">
                        <div class="grid md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold dark:text-gray-300">Nombre *</label>
                                <input 
                                    type="text" 
                                    name="name"
                                    required 
                                    class="w-full px-4 py-4 border border-slate-300 dark:border-slate-600 rounded-xl bg-transparent dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                    placeholder="Tu nombre completo"
                                >
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold dark:text-gray-300">Email *</label>
                                <input 
                                    type="email" 
                                    name="email"
                                    required 
                                    class="w-full px-4 py-4 border border-slate-300 dark:border-slate-600 rounded-xl bg-transparent dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                    placeholder="tu@email.com"
                                >
                            </div>
                        </div>
                        
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold dark:text-gray-300">Asunto *</label>
                            <select name="subject" class="w-full px-4 py-4 border border-slate-300 dark:border-slate-600 rounded-xl bg-transparent dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                                <option value="">Selecciona el tipo de proyecto</option>
                                <option value="web">Desarrollo Web</option>
                                <option value="app">Aplicación Móvil</option>
                                <option value="api">API & Backend</option>
                                <option value="consulting">Consultoría</option>
                                <option value="other">Otro</option>
                            </select>
                        </div>
                        
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold dark:text-gray-300">Mensaje *</label>
                            <textarea 
                                name="message"
                                rows="5" 
                                required
                                class="w-full px-4 py-4 border border-slate-300 dark:border-slate-600 rounded-xl bg-transparent dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all resize-none"
                                placeholder="Cuéntame sobre tu proyecto, objetivos y timeline..."
                            ></textarea>
                        </div>
                        
                        <button 
                            type="submit" 
                            class="w-full bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-bold py-5 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl"
                        >
                            <span class="flex items-center justify-center gap-3">
                                Enviar Mensaje
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                </svg>
                            </span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>