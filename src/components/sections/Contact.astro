---
import ContactCards from "@components/ui/react/ContactCards";
import ContactForm from "@components/ui/react/ContactForm";
---

<section
    id="contact"
    class="w-full from-slate-50 to-blue-50 dark:from-slate-900 dark:to-blue-900/10"
>
    <div class="max-w-7xl mx-auto px-4 md:px-10 py-24">
        <div class="text-center mb-16">
            <span
                class="text-blue-600 dark:text-blue-400 font-mono text-sm mb-4 block"
            >
                ¿Listo para comenzar?
            </span>
            <h2 class="text-5xl md:text-6xl font-bold dark:text-white mb-6">
                Hablemos de tu
                <span
                    class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-purple-600"
                >
                    proyecto
                </span>
            </h2>
            <p class="text-xl dark:text-gray-300 max-w-2xl mx-auto">
                Transformemos tus ideas en soluciones digitales impactantes.
                Estoy aquí para ayudarte a hacerlo realidad.
            </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-16 items-start">
            <ContactCards client:load />
            <ContactForm client:load />
        </div>
    </div>
</section>
